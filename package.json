{
  "name": "voice-input",
  "displayName": "Voice Input (Soniox STT)",
  "description": "Push-to-talk voice-to-text for any chat or editor input. Powered by Soniox.",
  "version": "1.1.0",
  "publisher": "david-stern",
  "author": {
    "name": "David Stern"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/david-stern/vscode-voice-input.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "ui"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "icon": "media/logo.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "voiceInput",
          "title": "Voice Input",
          "icon": "media/icon-activitybar.svg"
        }
      ]
    },
    "views": {
      "voiceInput": [
        {
          "type": "webview",
          "id": "voiceInput.micView",
          "name": "Microphone",
          "icon": "$(mic)"
        }
      ]
    },
    "commands": [
      {
        "command": "voiceInput.toggleRecording",
        "title": "Voice Input: Toggle Recording",
        "icon": "$(mic)"
      },
      {
        "command": "voiceInput.toggleAssistant",
        "title": "Voice Input: Toggle Assistant Listening"
      },
      {
        "command": "voiceInput.setApiKey",
        "title": "Voice Input: Set Soniox API Key"
      },
      {
        "command": "voiceInput.clearApiKey",
        "title": "Voice Input: Clear Soniox API Key"
      },
      {
        "command": "voiceInput.clearHistory",
        "title": "Voice Input: Clear History"
      },
      {
        "command": "voiceInput.showDiagnostics",
        "title": "Voice Input: Show Diagnostics"
      },
      {
        "command": "voiceInput.selectAudioDevice",
        "title": "Voice Input: Select Audio Device"
      }
    ],
    "keybindings": [
      {
        "command": "voiceInput.toggleRecording",
        "key": "alt+m",
        "mac": "ctrl+alt+m"
      }
    ],
    "configuration": {
      "title": "Voice Input",
      "properties": {
        "voiceInput.languageHint": {
          "type": "string",
          "default": "he",
          "description": "Soniox language hint (ISO code, e.g. he, en, ar, fa). 'auto' disables language_hints. Full list visible in the sidebar dropdown."
        },
        "voiceInput.uiLanguage": {
          "type": "string",
          "default": "en",
          "enum": [
            "he",
            "en"
          ],
          "description": "Sidebar UI language."
        },
        "voiceInput.audioDevice": {
          "type": "string",
          "default": "",
          "description": "Audio input device identifier managed by 'Voice Input: Select Audio Device' in the Command Palette or sidebar. Empty uses the system default."
        },
        "voiceInput.assistantWakePhrase": {
          "type": "string",
          "default": "",
          "description": "Optional assistant wake phrase. Empty uses the built-in Hebrew and English wake phrases."
        },
        "voiceInput.historyTtlDays": {
          "type": "number",
          "default": 30,
          "enum": [
            0,
            1,
            7,
            30
          ],
          "description": "Days to keep transcription history. 0 = forever."
        },
        "voiceInput.sttModel": {
          "type": "string",
          "default": "stt-async-v4",
          "description": "Soniox STT model identifier."
        },
        "voiceInput.injectionMode": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "paste-key",
            "type-key",
            "editor-only",
            "clipboard-only"
          ],
          "description": "auto: text-tab → editor cursor; else clipboard + Ctrl+V via ydotool. paste-key: always clipboard+Ctrl+V (best for Unicode/Hebrew). type-key: type chars via ydotool (US-layout only). editor-only / clipboard-only as named."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "compile": "tsc -p ./",
    "lint": "eslint src --ext ts",
    "test": "tsx --test test/*.test.ts test/**/*.test.ts",
    "publish": "bash scripts/release.sh"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "esbuild": "^0.20.0",
    "eslint": "^10.3.0",
    "tsx": "4.23.13",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@picovoice/pvrecorder-node": "1.2.9"
  }
}
